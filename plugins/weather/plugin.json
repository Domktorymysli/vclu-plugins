{
  "id": "weather",
  "name": "Weather Plugin",
  "version": "1.2.0",
  "author": "tytus",
  "license": "MIT",
  "description": "Pobiera dane pogodowe z OpenWeatherMap i udostępnia w Lua",
  "api": 2,
  "permissions": {
    "internet": {
      "hosts": [
        "api.openweathermap.org"
      ]
    }
  },
  "docs": [
    {
      "title": "Getting Started",
      "file": "README.md"
    }
  ],
  "requires": {
    "vclu": ">=1.13.0"
  },
  "config": {
    "apiKey": {
      "type": "string",
      "required": true,
      "description": "OpenWeatherMap API key"
    },
    "city": {
      "type": "string",
      "default": "Warsaw",
      "description": "Miasto do sprawdzania pogody"
    },
    "interval": {
      "type": "number",
      "default": 3600,
      "min": 300,
      "max": 86400,
      "description": "Interwał odświeżania w sekundach"
    },
    "units": {
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ],
      "default": "metric"
    }
  },
  "exports": {
    "objects": {
      "weather": {
        "type": "WeatherProvider",
        "description": "Główny obiekt pogodowy"
      }
    },
    "events": [
      {
        "name": "weather:changed",
        "description": "Emitowany gdy zmieni się pogoda"
      },
      {
        "name": "weather:rain",
        "description": "Emitowany gdy zacznie padać"
      }
    ]
  }
}
