{
  "settings": {
    "dashboard": {
      "type": "boolean", "default": true,
      "label": { "pl": "Pokaż listę na dashboardzie", "en": "Show the list on a dashboard" },
      "description": { "pl": "Odhaczanie i dopisywanie z telefonu, pod adresem /d/zakupy_lista", "en": "Tick off and add from a phone, at /d/zakupy_lista" }
    },
    "dashboardName": {
      "type": "string", "default": "Zakupy", "showIf": { "dashboard": true },
      "label": { "pl": "Nazwa", "en": "Name" }
    },
    "dashboardAuth": {
      "type": "enum", "options": ["session", "pin", "public"], "default": "session", "required": true, "showIf": { "dashboard": true },
      "optionLabels": {
        "session": { "pl": "Zalogowani do panelu", "en": "Signed in to the panel" },
        "pin": { "pl": "Z kodem PIN", "en": "With a PIN" },
        "public": { "pl": "Każdy w sieci domowej", "en": "Anyone at home" }
      },
      "label": { "pl": "Kto może otworzyć listę", "en": "Who can open the list" },
      "description": { "pl": "„Każdy w sieci domowej” wygodny na tablecie w kuchni, bez logowania", "en": "\"Anyone at home\" suits a kitchen tablet, no sign-in" }
    }
  }
}
